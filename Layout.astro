---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../consts';

interface Props {
  /** Page title. The site name is appended automatically; omit on the homepage. */
  title?: string;
  description?: string;
  type?: 'website' | 'article';
  /** Keep this page out of search engines (used by the gate). */
  noindex?: boolean;
  /** Path under /public for the social preview (jpg/png/webp; SVG is skipped). */
  image?: string;
}

const { title, description = SITE.description, type = 'website', noindex = false, image } = Astro.props;
const ogImage = image && !image.toLowerCase().endsWith('.svg') ? new URL(image, Astro.site) : undefined;

const fullTitle = title ? `${title} — ${SITE.name}` : SITE.title;
const canonical = new URL(Astro.url.pathname, Astro.site);
const rssUrl = new URL('rss.xml', Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title={`${SITE.name} RSS Feed`} href={rssUrl} />

    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}
    <meta name="theme-color" content="#0d0710" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Nav />
    <main id="main" class="container">
      <slot />
    </main>
    <Footer />
  </body>
</html>
