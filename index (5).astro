---
import Layout from '../../layouts/Layout.astro';
import PostCard from '../../components/PostCard.astro';
import TagFilter from '../../components/TagFilter.astro';
import { getPublishedPosts } from '../../lib/posts';

const posts = await getPublishedPosts();
const blurb = 'Every chronicle, across every realm, in the order Joe got around to writing them.';
---

<Layout title="Chronicles" description={blurb}>
  <header class="header">
    <h1>All chronicles</h1>
    <p class="tagline">{blurb}</p>
  </header>

  <TagFilter posts={posts} />

  {posts.length === 0 ? (
    <p class="empty">No chronicles yet.</p>
  ) : (
    <div class="log-grid">
      {posts.map((post) => <PostCard post={post} />)}
    </div>
  )}
</Layout>
