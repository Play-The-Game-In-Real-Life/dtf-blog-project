---
import { SITE, NAV_LINKS } from '../consts';

const path = Astro.url.pathname;
---

<nav class="navbar" aria-label="Primary">
  <a href="/" class="nav-brand">
    <span class="nav-glyph" aria-hidden="true">♥</span>
    <span>{SITE.short}<span class="nav-brand-dim">.com</span></span>
  </a>
  <ul class="nav-links">
    {NAV_LINKS.map((link) => {
      const active = 'match' in link && path.startsWith(link.match);
      return (
        <li>
          <a
            href={link.href}
            aria-current={active ? 'page' : undefined}
            class:list={[{ active }]}
            {...('external' in link ? { target: '_blank', rel: 'noopener' } : {})}
          >
            {link.label}
          </a>
        </li>
      );
    })}
    <li>
      <a href="/gate/" class="gate-link" aria-current={path.startsWith('/gate') ? 'page' : undefined}>/vault</a>
    </li>
  </ul>
</nav>
